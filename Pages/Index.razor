							<path d="M6 22 L6 40 Q6 44 10 44 L38 44 Q42 44 42 40 L42 22 Z" fill="#d4a52a" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<path d="M6 22 L10 14 L38 14 L42 22 Z" fill="#e9be45" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
