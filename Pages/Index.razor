@page "/"
@page "/draggable-desktop"
@layout DesktopLayout
@inject IJSRuntime JS

<PageTitle>chadmusick.com - Desktop</PageTitle>

<div class="desktop-menubar">
	<span class="menu-bar-path">C:\PROGRAMS\HOME.EXE</span>
</div>
<div id="desktop-area" class="desktop-area">

		<div id="desktop-icon-applications" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)applicationsLeft)px; top:@((int)applicationsTop)px;" @onclick="OpenLauncher">
			<img src="icons/PROGM004.PNG" alt="Applications" width="64" height="64">
			<span class="desktop-app-icon-label">Applications</span>
		</div>

		<div id="desktop-icon-websites" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)websitesLeft)px; top:@((int)websitesTop)px;" @onclick="OpenWebsites">
			<img src="icons/RASST001.PNG" alt="World Wide Websites" width="64" height="64">
			<span class="desktop-app-icon-label">World Wide Websites</span>
		</div>

		<div id="desktop-icon-photography" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)photographyLeft)px; top:@((int)photographyTop)px;" @onclick="OpenPhotography">
			<img src="icons/PROGM013.PNG" alt="Photography" width="64" height="64">
			<span class="desktop-app-icon-label">Photography</span>
		</div>

		<div id="desktop-icon-documents" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)documentsLeft)px; top:@((int)documentsTop)px;" @onclick="OpenDocuments">
			<img src="icons/MSMAI014.PNG" alt="Documents" width="64" height="64">
			<span class="desktop-app-icon-label">Documents</span>
		</div>

		<div id="desktop-icon-games" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)gamesLeft)px; top:@((int)gamesTop)px;" @onclick="OpenGames">
			<img src="icons/PROGM028.PNG" alt="Games" width="64" height="64">
			<span class="desktop-app-icon-label">Productivity</span>
		</div>

		<div id="desktop-icon-email" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)emailLeft)px; top:@((int)emailTop)px;" @onclick="OpenContact">
			<img src="icons/PROGM035.PNG" alt="Electronic Mail" width="64" height="64">
			<span class="desktop-app-icon-label">Electronic Mail</span>
		</div>

		<div id="desktop-icon-trash" class="desktop-app-icon desktop-trash-icon" role="button" draggable="true" @onclick="OpenTrash">
			<img src="icons/MSMAI016.PNG" alt="Trash Can" width="64" height="64">
			<span class="desktop-app-icon-label">Trash</span>
		</div>

		<div id="launcher-window" class="launcher-window draggable-window @(launcherOpen ? string.Empty : "window-hidden")">
			<div id="launcher-titlebar" class="launcher-titlebar draggable-window-handle">
				<span>APPLICATIONS</span>
				<button class="launcher-close" @onclick="CloseLauncher" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="launcher-content">
				<a href="https://github.com/robotlions/moderncoffeecurrent" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM005.PNG" alt="Modern Coffee" width="64" height="64">
					</span>
					<span class="launcher-label">Modern Coffee</span>
				</a>
				<a href="https://github.com/robotlions/in-key-mobile" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/SOUND001.PNG" alt="In Key" width="64" height="64">
					</span>
					<span class="launcher-label">In Key</span>
				</a>
				<a href="https://github.com/robotlions/AtomicPress" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM001.PNG" alt="AtomicPress" width="64" height="64">
					</span>
					<span class="launcher-label">AtomicPress</span>
				</a>
			</div>
		</div>

		<div id="documents-window" class="documents-window draggable-window @(documentsOpen ? string.Empty : "window-hidden")">
			<div id="documents-titlebar" class="documents-titlebar draggable-window-handle">
				<span>DOCUMENTS</span>
				<button class="documents-close" @onclick="CloseDocuments" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="documents-content">
				<div class="documents-link" role="button" tabindex="0" draggable="true" @onclick="OpenReadme" @onkeydown="OnReadmeKeyDown" data-tx="-40" data-ty="-30" style="transform: translate(-40px, -30px);">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/NOTEP001.PNG" alt="README.TXT" width="64" height="64">
					</span>
					<span class="launcher-label">README.TXT</span>
				</div>
			</div>
		</div>

		<div id="photography-window" class="photography-window draggable-window @(photographyOpen ? string.Empty : "window-hidden")">
			<div id="photography-titlebar" class="photography-titlebar draggable-window-handle">
				<span>PHOTOGRAPHY</span>
				<button class="photography-close" @onclick="ClosePhotography" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="photography-content">
				<a href="https://flickr.com/photos/183126740@N02/" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/CLIPB003.PNG" alt="Photo Album" width="64" height="64">
					</span>
					<span class="launcher-label">Photo Album</span>
				</a>
			</div>
		</div>

		<div id="websites-window" class="websites-window draggable-window @(websitesOpen ? string.Empty : "window-hidden")">
			<div id="websites-titlebar" class="websites-titlebar draggable-window-handle">
				<span>WORLD WIDE WEBSITES</span>
				<button class="websites-close" @onclick="CloseWebsites" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="launcher-content">
				<a href="https://dnd35.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM028.PNG" alt="D&D Characters" width="64" height="64">
					</span>
					<span class="launcher-label">D&D Characters</span>
				</a>
				<a href="https://scale-o-matic.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM030.PNG" alt="Scale-O-Matic" width="64" height="64">
					</span>
					<span class="launcher-label">Scale-O-Matic</span>
				</a>
				<a href="https://goldbox.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="RPG Editor" width="64" height="64">
					</span>
					<span class="launcher-label">RPG Editor</span>
				</a>
			</div>
		</div>

		<div id="dosbox-window" class="dosbox-window draggable-window @(dosboxOpen ? string.Empty : "window-hidden")">
			<div id="dosbox-titlebar" class="dosbox-titlebar draggable-window-handle">
				<span>DOSBOX</span>
				<button class="dosbox-close" @onclick="CloseDosbox" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="dosbox-content">
				<div id="dosbox-container" class="dosbox-container"></div>
				<div id="dosbox-loading" class="dosbox-loading">LOADING DOSBOX...</div>
			</div>
		</div>

		<div id="games-window" class="games-window draggable-window @(gamesOpen ? string.Empty : "window-hidden")">
			<div id="games-titlebar" class="games-titlebar draggable-window-handle">
				<span>PRODUCTIVITY</span>
				<button class="games-close" @onclick="CloseGames" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="games-content">
				<div class="games-link" role="button" tabindex="0" @onclick="() => OpenDosbox(PoolOfRadianceUrl)" @onkeydown="(e) => OnGamesKeyDown(e, PoolOfRadianceUrl)">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="Pool of Radiance" width="64" height="64">
					</span>
					<span class="launcher-label">Pool of Radiance</span>
				</div>
				<div class="games-link" role="button" tabindex="0" @onclick="() => OpenDosbox(CivilizationUrl)" @onkeydown="(e) => OnGamesKeyDown(e, CivilizationUrl)">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="Civilization" width="64" height="64">
					</span>
					<span class="launcher-label">Civilization</span>
				</div>
				<div class="games-link" role="button" tabindex="0" @onclick="() => OpenDosbox(QuestForGloryUrl)" @onkeydown="(e) => OnGamesKeyDown(e, QuestForGloryUrl)">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="Quest for Glory" width="64" height="64">
					</span>
					<span class="launcher-label">Quest for Glory</span>
				</div>
				<div class="games-link" role="button" tabindex="0" @onclick="() => OpenDosbox(BardsTaleUrl)" @onkeydown="(e) => OnGamesKeyDown(e, BardsTaleUrl)">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="The Bard's Tale" width="64" height="64">
					</span>
					<span class="launcher-label">The Bard's Tale</span>
				</div>
			</div>
		</div>

		<div id="contact-window" class="contact-window draggable-window @(contactOpen ? string.Empty : "window-hidden")">
			<div id="contact-titlebar" class="contact-titlebar draggable-window-handle">
				<span>ELECTRONIC MAIL</span>
				<button class="contact-close" @onclick="CloseContact" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="contact-body">
				<label class="contact-label" for="contact-name">Name</label>
				<input id="contact-name" class="contact-input" type="text" @bind="contactName" @bind:event="oninput" />
				<label class="contact-label" for="contact-email">Your Email</label>
				<input id="contact-email" class="contact-input" type="email" @bind="contactEmail" @bind:event="oninput" />
				<label class="contact-label" for="contact-message">Message</label>
				<textarea id="contact-message" class="contact-textarea" @bind="contactMessage" @bind:event="oninput"></textarea>
				<div class="contact-actions">
					<button type="button" class="contact-send" @onclick="SendContact" disabled="@contactSending">SEND</button>
					<a class="contact-mailto" href="mailto:info@robotlions.com">or email directly</a>
				</div>
				@if (!string.IsNullOrEmpty(contactStatus))
				{
					<div class="contact-status">@contactStatus</div>
				}
			</div>
		</div>

		<div id="trash-window" class="trash-window draggable-window @(trashOpen ? string.Empty : "window-hidden")">
			<div id="trash-titlebar" class="trash-titlebar draggable-window-handle">
				<span>TRASH</span>
				<button class="trash-close" @onclick="CloseTrash" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="trash-content">
				<div class="trash-link" role="button" tabindex="0" draggable="true" @onclick="OpenSpoilers" @onkeydown="OnSpoilersKeyDown" data-tx="-40" data-ty="-30" style="transform: translate(-40px, -30px);">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/NOTEP001.PNG" alt="TOPSECRT.TXT" width="64" height="64">
					</span>
					<span class="launcher-label">TOPSECRT.TXT</span>
				</div>
			</div>
		</div>

		@if (readmeModalOpen)
		{
			<div class="readme-modal-overlay" @onclick="CloseReadme">
				<div class="readme-modal" role="dialog" aria-modal="true" aria-label="README.TXT" @onclick:stopPropagation>
					<div class="readme-modal-titlebar">
						<span>README.TXT</span>
						<button class="readme-modal-close" @onclick="CloseReadme" aria-label="Close">
							<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
								<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
							</svg>
						</button>
					</div>
					<div class="readme-modal-body">
						<div>I'm a front-end web developer specializing in Javascript and React, although this site was written in Blazor. These are my mobile apps and websites, except for the stuff under Productivity, which were the inspirations for a lot of my work. Thank you for visiting!</div>
					</div>
				</div>
			</div>
		}

		@if (spoilersModalOpen)
		{
			<div class="spoilers-modal-overlay" @onclick="CloseSpoilers">
				<div class="spoilers-modal" role="dialog" aria-modal="true" aria-label="TOPSECRT.TXT" @onclick:stopPropagation>
					<div class="spoilers-modal-titlebar">
						<span>TOPSECRT.TXT</span>
						<button class="spoilers-modal-close" @onclick="CloseSpoilers" aria-label="Close">
							<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
								<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
							</svg>
						</button>
					</div>
					<div class="spoilers-modal-body">
						@foreach (var spoiler in MovieSpoilers)
						{
							<div class="spoiler-entry">@spoiler</div>
						}
					</div>
				</div>
			</div>
		}
</div>

@implements IAsyncDisposable

@code {
	private DotNetObjectReference<Index>? objRef;
	private IJSObjectReference? _jsModule;
	private bool launcherOpen = false;
	private bool documentsOpen = true;
	private bool readmeModalOpen = false;
	private bool photographyOpen = false;
	private bool websitesOpen = false;
	private double applicationsLeft = 20.0;
	private double applicationsTop = 12.0;
	private double websitesLeft = 20.0;
	private double websitesTop = 162.0;
	private double photographyLeft = 20.0;
	private double photographyTop = 312.0;
	private double documentsLeft = 150.0;
	private double documentsTop = 12.0;
	private bool dosboxOpen = false;
	private bool _pendingDosboxStart = false;
	private bool gamesOpen = false;
	private double gamesLeft = 150.0;
	private double gamesTop = 312.0;
	private double emailLeft = 150.0;
	private double emailTop = 162.0;
	private bool trashOpen = false;
	private bool spoilersModalOpen = false;
	private bool contactOpen = false;
	private string contactName = "";
	private string contactEmail = "";
	private string contactMessage = "";
	private string contactStatus = "";
	private bool contactSending = false;

	private const string PoolOfRadianceUrl = "/games/POOLRAD.jsdos";
	private const string CivilizationUrl = "/games/CIV.jsdos";
	private const string QuestForGloryUrl = "/games/HERO.jsdos";
	private const string BardsTaleUrl = "/games/BARD.jsdos";
	private string DosboxGameUrl = "";

	private static readonly string[] MovieSpoilers = new[]
	{
		("- He's a ghost the entire time."),
		("- Tyler is the narrator's alter ego."),
		("- Darth is Luke's father."),
		("- Leia is also his sister for some reason."),
		("- Keyser Söze is Verbal Kint."),
		("- Rosebud is the sled."),
		("- The magician was twin brothers."),
		("- The Wizard is just a man behind a curtain."),
		("- The mother is actually Norman."),
		("- The three college friends aren't real."),
		("- They were on Earth all along.")
	};

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
			_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");
		}
		if (_jsModule != null && objRef != null)
		{
			await _jsModule.InvokeVoidAsync("registerAppIconDrag", objRef);
			await _jsModule.InvokeVoidAsync("registerDesktopWindowDrag");
			await _jsModule.InvokeVoidAsync("registerLauncherIconDrag");
		}
		if (_pendingDosboxStart)
		{
			_pendingDosboxStart = false;
			if (_jsModule != null)
			{
				try { await _jsModule.InvokeVoidAsync("startDosbox", DosboxGameUrl); } catch { }
			}
		}
	}

	private async Task OpenDocuments()
	{
		documentsOpen = true;
		await BringWindowToFront("documents-window");
	}

	private void CloseLauncher() => launcherOpen = false;

	private void CloseDocuments() => documentsOpen = false;

	private void OpenReadme() => readmeModalOpen = true;

	private void CloseReadme() => readmeModalOpen = false;

	private void OnReadmeKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter" || e.Key == " ")
		{
			OpenReadme();
		}
	}

	private async Task OpenLauncher()
	{
		launcherOpen = true;
		await BringWindowToFront("launcher-window");
	}

	private void ClosePhotography() => photographyOpen = false;

	private async Task OpenPhotography()
	{
		photographyOpen = true;
		await BringWindowToFront("photography-window");
	}

	private void CloseWebsites() => websitesOpen = false;

	private async Task OpenWebsites()
	{
		websitesOpen = true;
		await BringWindowToFront("websites-window");
	}

	private async Task CloseDosbox()
	{
		dosboxOpen = false;
		await StopDosbox();
	}

	private async Task OpenDosbox(string gameUrl)
	{
		DosboxGameUrl = gameUrl;
		dosboxOpen = true;
		_pendingDosboxStart = true;
		await BringWindowToFront("dosbox-window");
	}

	private async Task CloseGames()
	{
		gamesOpen = false;
		dosboxOpen = false;
		await StopDosbox();
	}

	private async Task StopDosbox()
	{
		if (_jsModule != null)
		{
			try { await _jsModule.InvokeVoidAsync("stopDosbox"); } catch { }
		}
	}

	private async Task OpenGames()
	{
		gamesOpen = true;
		await BringWindowToFront("games-window");
	}

	private void CloseContact() => contactOpen = false;

	private async Task OpenTrash()
	{
		trashOpen = true;
		await BringWindowToFront("trash-window");
	}

	private void CloseTrash() => trashOpen = false;

	private void OpenSpoilers() => spoilersModalOpen = true;

	private void CloseSpoilers() => spoilersModalOpen = false;

	private void OnSpoilersKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter" || e.Key == " ")
		{
			OpenSpoilers();
		}
	}

	private async Task OpenContact()
	{
		contactOpen = true;
		contactStatus = "";
		await BringWindowToFront("contact-window");
	}

	private async Task SendContact()
	{
		if (contactSending) return;
		if (string.IsNullOrWhiteSpace(contactName) || string.IsNullOrWhiteSpace(contactMessage))
		{
			contactStatus = "ENTER A NAME AND MESSAGE";
			return;
		}
		contactSending = true;
		contactStatus = "SENDING...";
		try
		{
			if (_jsModule != null)
			{
				var result = await _jsModule.InvokeAsync<ContactSubmitResult>("submitContactForm", new
				{
					name = contactName,
					email = contactEmail,
					message = contactMessage
				});
				contactStatus = result.Ok ? "MESSAGE SENT" : (result.Message ?? "REQUEST FAILED");
				if (result.Ok)
				{
					contactName = "";
					contactEmail = "";
					contactMessage = "";
				}
			}
		}
		catch
		{
			contactStatus = "SEND FAILED - TRY AGAIN";
		}
		contactSending = false;
	}

	private class ContactSubmitResult
	{
		public bool Ok { get; set; }
		public string? Message { get; set; }
	}

	private async Task OnGamesKeyDown(KeyboardEventArgs e, string gameUrl)
	{
		if (e.Key == "Enter" || e.Key == " ")
		{
			await OpenDosbox(gameUrl);
		}
	}

	private async Task BringWindowToFront(string windowId)
	{
		if (_jsModule != null)
		{
			await _jsModule.InvokeVoidAsync("bringToFront", windowId);
		}
	}

	[JSInvokable]
	public Task OnAppIconMoved(string iconId, double left, double top)
	{
		switch (iconId)
		{
			case "desktop-icon-applications":
				applicationsLeft = left;
				applicationsTop = top;
				break;
			case "desktop-icon-websites":
				websitesLeft = left;
				websitesTop = top;
				break;
			case "desktop-icon-photography":
				photographyLeft = left;
				photographyTop = top;
				break;
			case "desktop-icon-documents":
				documentsLeft = left;
				documentsTop = top;
				break;
			case "desktop-icon-games":
				gamesLeft = left;
				gamesTop = top;
				break;
			case "desktop-icon-email":
				emailLeft = left;
				emailTop = top;
				break;
		}
		StateHasChanged();
		return Task.CompletedTask;
	}

	public async ValueTask DisposeAsync()
	{
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterAppIconDrag"); } catch { }
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterDesktopWindowDrag"); } catch { }
		if (_jsModule != null) await _jsModule.DisposeAsync();
		objRef?.Dispose();
	}
}
