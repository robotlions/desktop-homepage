@page "/"
@page "/draggable-desktop"
@layout DesktopLayout
@inject IJSRuntime JS

<HeadContent>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
</HeadContent>

<PageTitle>chadmusick.com</PageTitle>

<div class="row">
	<div class="desktop-menubar">
		<span class="menu-apple">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 26" width="18" height="20">
				<rect x="0" y="0" width="24" height="18" rx="2" fill="#111" />
				<rect x="2" y="2" width="20" height="13" fill="#fff" />
				<rect x="9" y="18" width="6" height="4" fill="#111" />
				<rect x="3" y="22" width="18" height="3" rx="1" fill="#111" />
			</svg>
		</span>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenLauncher">Applications</button>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenWebsites">World Wide Websites</button>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenPhotography">Photography</button>
	</div>
</div>
<div class="row">
	<div id="desktop-area" class="desktop-area col-12">

		@if (folderVisible)
		{
			<div id="folder" class="folder" draggable="true" @onclick="ReleaseFromFolder"
				 style="position:absolute; left:@((int)folderLeft)px; top:@((int)folderTop)px; z-index:10;">
				@if (textFileInFolder)
				{
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="51" height="51">
						<!-- back tab of folder -->
						<rect x="4" y="8" width="22" height="10" fill="#d4b56a" stroke="#000" stroke-width="2"/>
						<!-- paper peeking out -->
						<rect x="24" y="6" width="18" height="22" fill="#ffffff" stroke="#000" stroke-width="1.5"/>
						<rect x="36" y="6" width="6" height="6" fill="#d8d8d8" stroke="#000" stroke-width="1.5"/>
						<line x1="27" y1="12" x2="39" y2="12" stroke="#9aa0a8" stroke-width="1.25"/>
						<line x1="27" y1="16" x2="39" y2="16" stroke="#9aa0a8" stroke-width="1.25"/>
						<line x1="27" y1="20" x2="34" y2="20" stroke="#9aa0a8" stroke-width="1.25"/>
						<!-- folder body (front) -->
						<rect x="4" y="14" width="40" height="30" fill="#e9c984" stroke="#000" stroke-width="2"/>
						<!-- inner highlight strip -->
						<rect x="6" y="16" width="36" height="4" fill="#f5e4b8"/>
						<!-- right edge shadow -->
						<rect x="40" y="16" width="3" height="26" fill="#b8902e" opacity="0.55"/>
					</svg>
				}
				else
				{
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="51" height="51">
						<!-- back tab of folder -->
						<rect x="4" y="8" width="22" height="10" fill="#d4b56a" stroke="#000" stroke-width="2"/>
						<!-- folder body (front) -->
						<rect x="4" y="14" width="40" height="30" fill="#e9c984" stroke="#000" stroke-width="2"/>
						<!-- inner highlight strip -->
						<rect x="6" y="16" width="36" height="4" fill="#f5e4b8"/>
						<!-- right edge shadow -->
						<rect x="40" y="16" width="3" height="26" fill="#b8902e" opacity="0.55"/>
					</svg>
				}
			</div>
		}

		@if (textFileVisible)
		{
			<div id="text-file" class="text-file" draggable="true" @ondblclick="OpenNotepad"
				 style="position:absolute; left:@((int)textFileLeft)px; top:@((int)textFileTop)px; z-index:10;">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="51" height="51">
					<rect x="6" y="4" width="36" height="40" fill="#ffffff" stroke="#000" stroke-width="2"/>
					<rect x="36" y="4" width="6" height="10" fill="#d8d8d8" stroke="#000" stroke-width="2"/>
					<rect x="10" y="9" width="22" height="22" fill="#c3c9d0" stroke="#8b93a0" stroke-width="1.25"/>
					<line x1="13" y1="14" x2="29" y2="14" stroke="#8b93a0" stroke-width="1.25"/>
					<line x1="13" y1="18" x2="29" y2="18" stroke="#8b93a0" stroke-width="1.25"/>
					<line x1="13" y1="22" x2="29" y2="22" stroke="#8b93a0" stroke-width="1.25"/>
					<line x1="13" y1="26" x2="24" y2="26" stroke="#8b93a0" stroke-width="1.25"/>
					<line x1="10" y1="35" x2="38" y2="35" stroke="#a0a6ad" stroke-width="1.5"/>
					<line x1="10" y1="40" x2="38" y2="40" stroke="#a0a6ad" stroke-width="1.5"/>
				</svg>
			</div>
		}

		<div id="trash-container"
			 class="trash @((!folderVisible || (!textFileVisible && !textFileInFolder)) ? "clickable" : "")"
			 @onclick="ResetAll">
			@if (!folderVisible || (!textFileVisible && !textFileInFolder))
			{
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="51" height="51">
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round"/>
					<path d="M10 15 L38 15 L35 42 L13 42 Z" fill="#b8c0c8" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
					<rect x="10" y="14" width="28" height="4" fill="#e8edf1" stroke="#000" stroke-width="2"/>
					<line x1="16" y1="20" x2="32" y2="20" stroke="#6b737f" stroke-width="1.25"/>
					<line x1="16" y1="26" x2="32" y2="26" stroke="#6b737f" stroke-width="1.25"/>
					<line x1="16" y1="32" x2="31" y2="32" stroke="#6b737f" stroke-width="1.25"/>
					<path d="M20 18 L18 12 L24 14 L22 6 L28 16 L26 12" fill="#ffffff" stroke="#000" stroke-width="1.25" stroke-linejoin="round"/>
				</svg>
			}
			else
			{
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="51" height="51">
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round"/>
					<path d="M10 15 L38 15 L35 42 L13 42 Z" fill="#d2d8de" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
					<rect x="10" y="14" width="28" height="4" fill="#e8edf1" stroke="#000" stroke-width="2"/>
					<line x1="16" y1="20" x2="32" y2="20" stroke="#7a8088" stroke-width="1.25"/>
					<line x1="16" y1="26" x2="32" y2="26" stroke="#7a8088" stroke-width="1.25"/>
					<line x1="16" y1="32" x2="31" y2="32" stroke="#7a8088" stroke-width="1.25"/>
				</svg>
			}
		</div>

		<div id="launcher-window" class="launcher-window draggable-window @(launcherOpen ? string.Empty : "window-hidden")">
			<div id="launcher-titlebar" class="launcher-titlebar draggable-window-handle">
				<span>APPLICATIONS</span>
				<button class="launcher-close" @onclick="CloseLauncher">✕</button>
			</div>
			<div class="launcher-content">
