@page "/"
@page "/draggable-desktop"
@layout DesktopLayout
@inject IJSRuntime JS

<HeadContent>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
</HeadContent>

<PageTitle>chadmusick.com</PageTitle>

<div class="row">
	<div class="desktop-menubar">
		<span class="menu-apple">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 26" width="18" height="20">
				<rect x="0" y="0" width="24" height="18" rx="2" fill="#111" />
				<rect x="2" y="2" width="20" height="13" fill="#fff" />
				<rect x="9" y="18" width="6" height="4" fill="#111" />
				<rect x="3" y="22" width="18" height="3" rx="1" fill="#111" />
			</svg>
		</span>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenLauncher">Applications</button>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenDocuments">Documents</button>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenWebsites">World Wide Websites</button>
		<button type="button" class="menu-link menu-link-button" @onclick="OpenPhotography">Photography</button>
	</div>
</div>
<div class="row">
	<div id="desktop-area" class="desktop-area col-12">

		@if (folderVisible && !folderHidden)
		{
			<div id="folder" class="folder" draggable="true" @onclick="ReleaseFromFolder"
				 style="position:absolute; left:@((int)folderLeft)px; top:@((int)folderTop)px; z-index:10;">
				@if (textFileInFolder)
				{
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="64" height="64">
						<!-- back tab of folder -->
						<rect x="6" y="6" width="20" height="9" fill="#d4b56a" stroke="#000" stroke-width="2"/>
						<!-- paper peeking out -->
						<rect x="24" y="6" width="18" height="22" fill="#ffffff" stroke="#000" stroke-width="1.5"/>
						<rect x="36" y="6" width="6" height="6" fill="#d8d8d8" stroke="#000" stroke-width="1.5"/>
						<line x1="27" y1="12" x2="39" y2="12" stroke="#9aa0a8" stroke-width="1.25"/>
						<line x1="27" y1="16" x2="39" y2="16" stroke="#9aa0a8" stroke-width="1.25"/>
						<line x1="27" y1="20" x2="34" y2="20" stroke="#9aa0a8" stroke-width="1.25"/>
						<!-- folder body (front) -->
						<rect x="4" y="12" width="40" height="30" fill="#e9c984" stroke="#000" stroke-width="2"/>
						<!-- inner highlight strip -->
						<rect x="6" y="14" width="36" height="4" fill="#f5e4b8"/>
						<!-- right edge shadow -->
						<rect x="40" y="14" width="3" height="26" fill="#b8902e" opacity="0.55"/>
					</svg>
				}
				else
				{
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="64" height="64">
						<!-- back tab of folder -->
						<rect x="6" y="6" width="20" height="9" fill="#d4b56a" stroke="#000" stroke-width="2"/>
						<!-- folder body (front) -->
						<rect x="4" y="12" width="40" height="30" fill="#e9c984" stroke="#000" stroke-width="2"/>
						<!-- inner highlight strip -->
						<rect x="6" y="14" width="36" height="4" fill="#f5e4b8"/>
						<!-- right edge shadow -->
						<rect x="40" y="14" width="3" height="26" fill="#b8902e" opacity="0.55"/>
					</svg>
				}
			</div>
		}

		@if (textFileVisible)
		{
			<div id="text-file" class="text-file" draggable="true" @onclick="OpenNotepad"
				 style="position:absolute; left:@((int)textFileLeft)px; top:@((int)textFileTop)px; z-index:10;">
				<img src="icons/PROGM029.PNG" alt="Notepad" width="64" height="64">
				<span class="desktop-app-icon-label">Notepad</span>
			</div>
		}

		<div id="trash-container"
			 class="trash @((!folderVisible || (!textFileVisible && !textFileInFolder)) ? "clickable" : "")"
			 @onclick="ResetAll">
			@if (!folderVisible || (!textFileVisible && !textFileInFolder))
			{
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="64" height="64">
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round"/>
					<path d="M10 15 L38 15 L35 42 L13 42 Z" fill="#c0c0c0" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
					<rect x="10" y="14" width="28" height="4" fill="#e8e8e8" stroke="#000" stroke-width="2"/>
					<line x1="16" y1="20" x2="32" y2="20" stroke="#808080" stroke-width="1.25"/>
					<line x1="16" y1="26" x2="32" y2="26" stroke="#808080" stroke-width="1.25"/>
					<line x1="16" y1="32" x2="31" y2="32" stroke="#808080" stroke-width="1.25"/>
					<path d="M20 18 L18 12 L24 14 L22 6 L28 16 L26 12" fill="#ffffff" stroke="#000" stroke-width="1.25" stroke-linejoin="round"/>
				</svg>
			}
			else
			{
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="64" height="64">
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
					<path d="M14 15 Q14 6 24 6 Q34 6 34 15" fill="none" stroke="#000" stroke-width="2" stroke-linecap="round"/>
					<path d="M10 15 L38 15 L35 42 L13 42 Z" fill="#c0c0c0" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
					<rect x="10" y="14" width="28" height="4" fill="#e8e8e8" stroke="#000" stroke-width="2"/>
					<line x1="16" y1="20" x2="32" y2="20" stroke="#808080" stroke-width="1.25"/>
					<line x1="16" y1="26" x2="32" y2="26" stroke="#808080" stroke-width="1.25"/>
					<line x1="16" y1="32" x2="31" y2="32" stroke="#808080" stroke-width="1.25"/>
				</svg>
			}
		</div>

		<div id="desktop-icon-applications" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)applicationsLeft)px; top:@((int)applicationsTop)px;" @onclick="OpenLauncher">
			<img src="icons/PROGM004.PNG" alt="Applications" width="64" height="64">
			<span class="desktop-app-icon-label">Applications</span>
		</div>

		<div id="desktop-icon-websites" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)websitesLeft)px; top:@((int)websitesTop)px;" @onclick="OpenWebsites">
			<img src="icons/RASST001.PNG" alt="World Wide Websites" width="64" height="64">
			<span class="desktop-app-icon-label">World Wide Websites</span>
		</div>

		<div id="desktop-icon-photography" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)photographyLeft)px; top:@((int)photographyTop)px;" @onclick="OpenPhotography">
			<img src="icons/PROGM013.PNG" alt="Photography" width="64" height="64">
			<span class="desktop-app-icon-label">Photography</span>
		</div>

		<div id="desktop-icon-documents" class="desktop-app-icon" role="button" draggable="true" style="left:@((int)documentsLeft)px; top:@((int)documentsTop)px;" @onclick="OpenDocuments">
			<img src="icons/MSMAI014.PNG" alt="Documents" width="64" height="64">
			<span class="desktop-app-icon-label">Documents</span>
		</div>

		<div id="launcher-window" class="launcher-window draggable-window @(launcherOpen ? string.Empty : "window-hidden")">
			<div id="launcher-titlebar" class="launcher-titlebar draggable-window-handle">
				<span>APPLICATIONS</span>
				<button class="launcher-close" @onclick="CloseLauncher" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="launcher-content">
				<a href="https://github.com/robotlions/moderncoffeecurrent" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="18" y="4" width="4" height="6" fill="#000" stroke="#000" stroke-width="1"/>
							<rect x="24" y="10" width="4" height="6" fill="#000" stroke="#000" stroke-width="1"/>
							<rect x="8" y="16" width="26" height="26" fill="#ffffff" stroke="#000" stroke-width="2"/>
							<path d="M34 20 H40 Q46 20 46 24 Q46 32 40 32 H36" fill="none" stroke="#000" stroke-width="3" stroke-linecap="round"/>
							<path d="M38 22 H41 Q43 22 43 24 Q43 30 41 30 H38" fill="#c0c0c0" stroke="#000" stroke-width="2"/>
							<rect x="10" y="18" width="22" height="7" fill="#3a2a14" stroke="#000" stroke-width="1.5"/>
							<rect x="10" y="18" width="22" height="2" fill="#6b4a24"/>
						</svg>
					</span>
					<span class="launcher-label">Modern Coffee</span>
				</a>
				<a href="https://github.com/robotlions/in-key-mobile" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/SOUND001.PNG" alt="In Key" width="64" height="64">
					</span>
					<span class="launcher-label">In Key</span>
				</a>
				<a href="https://github.com/robotlions/AtomicPress" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="14" y="2" width="20" height="20" fill="#ffffff" stroke="#000" stroke-width="2"/>
							<rect x="14" y="2" width="8" height="8" fill="#c0c0c0" stroke="#000" stroke-width="1.5"/>
							<line x1="18" y1="14" x2="30" y2="14" stroke="#808080" stroke-width="1.5"/>
							<line x1="18" y1="18" x2="28" y2="18" stroke="#808080" stroke-width="1.5"/>
							<rect x="9" y="20" width="30" height="6" fill="#808080" stroke="#000" stroke-width="2"/>
							<rect x="5" y="26" width="38" height="12" fill="#c0c0c0" stroke="#000" stroke-width="2"/>
							<rect x="11" y="30" width="26" height="4" fill="#000"/>
							<rect x="18" y="38" width="12" height="8" fill="#ffffff" stroke="#000" stroke-width="1.5"/>
						</svg>
					</span>
					<span class="launcher-label">AtomicPress</span>
				</a>
			</div>
		</div>

		<div id="documents-window" class="documents-window draggable-window @(documentsOpen ? string.Empty : "window-hidden")">
			<div id="documents-titlebar" class="documents-titlebar draggable-window-handle">
				<span>DOCUMENTS</span>
				<button class="documents-close" @onclick="CloseDocuments" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="documents-content">
				<div class="documents-link" role="button" tabindex="0" @onclick="OpenReadme" @onkeydown="OnReadmeKeyDown">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/NOTEP001.PNG" alt="README.TXT" width="64" height="64">
					</span>
					<span class="launcher-label">README.TXT</span>
				</div>
			</div>
		</div>

		<div id="notepad-window" class="notepad-window draggable-window @(notepadOpen ? string.Empty : "window-hidden")">
			<div id="notepad-titlebar" class="notepad-titlebar draggable-window-handle">
				<span>NOTEPAD</span>
				<button class="notepad-close" @onclick="CloseNotepad" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="notepad-body">
				<textarea @ref="_notepadRef" class="notepad-content" @bind="notepadContent" @bind:event="oninput"></textarea>
				@if (string.IsNullOrEmpty(notepadContent))
				{
					<span class="notepad-cursor" aria-hidden="true"></span>
				}
			</div>
		</div>

		<div id="photography-window" class="photography-window draggable-window @(photographyOpen ? string.Empty : "window-hidden")">
			<div id="photography-titlebar" class="photography-titlebar draggable-window-handle">
				<span>PHOTOGRAPHY</span>
				<button class="photography-close" @onclick="ClosePhotography" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="photography-content">
				<a href="https://flickr.com/photos/183126740@N02/" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="10" y="4" width="18" height="6" fill="#808080" stroke="#000" stroke-width="2"/>
							<rect x="4" y="10" width="40" height="8" fill="#808080" stroke="#000" stroke-width="2"/>
							<rect x="4" y="18" width="40" height="26" fill="#c0c0c0" stroke="#000" stroke-width="2"/>
							<circle cx="24" cy="31" r="9" fill="#0000a8" stroke="#000" stroke-width="2"/>
							<circle cx="24" cy="31" r="6" fill="#000080"/>
							<circle cx="21" cy="28" r="2" fill="#ffffff"/>
							<circle cx="38" cy="14" r="1.5" fill="#a80000"/>
						</svg>
					</span>
					<span class="launcher-label">Photos</span>
				</a>
			</div>
		</div>

		<div id="websites-window" class="websites-window draggable-window @(websitesOpen ? string.Empty : "window-hidden")">
			<div id="websites-titlebar" class="websites-titlebar draggable-window-handle">
				<span>WORLD WIDE WEBSITES</span>
				<button class="websites-close" @onclick="CloseWebsites" aria-label="Close">
					<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
						<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
					</svg>
				</button>
			</div>
			<div class="launcher-content">
				<a href="https://dnd35.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM028.PNG" alt="D&D Characters" width="64" height="64">
					</span>
					<span class="launcher-label">D&D Characters</span>
				</a>
				<a href="https://scale-o-matic.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/PROGM030.PNG" alt="Scale-O-Matic" width="64" height="64">
					</span>
					<span class="launcher-label">Scale-O-Matic</span>
				</a>
				<a href="https://goldbox.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<img src="icons/WINSE001.PNG" alt="RPG Editor" width="64" height="64">
					</span>
					<span class="launcher-label">RPG Editor</span>
				</a>
			</div>
		</div>

		@if (readmeModalOpen)
		{
			<div class="readme-modal-overlay" @onclick="CloseReadme">
				<div class="readme-modal" role="dialog" aria-modal="true" aria-label="README.TXT" @onclick:stopPropagation>
					<div class="readme-modal-titlebar">
						<span>README.TXT</span>
						<button class="readme-modal-close" @onclick="CloseReadme" aria-label="Close">
							<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
								<path d="M1 1 L11 11 M11 1 L1 11" stroke="#000" stroke-width="2.5"/>
							</svg>
						</button>
					</div>
					<div class="readme-modal-body">
						<div>Your onramp to the information superhighway.</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

@implements IAsyncDisposable

@code {
	private DotNetObjectReference<Index>? objRef;
	private IJSObjectReference? _jsModule;
	private ElementReference _notepadRef;
	private bool notepadOpen = false;
	private bool _focusNotepad = false;
	private string notepadContent = "";
	private bool launcherOpen = false;
	private bool documentsOpen = true;
	private bool readmeModalOpen = false;
	private bool photographyOpen = false;
	private bool websitesOpen = false;
	private bool folderVisible = true;
	private bool folderHidden = true;
	private double folderLeft = 60.0;
	private double folderTop = 12.0;
	private bool textFileVisible = true;
	private double textFileLeft = 60.0;
	private double textFileTop = 85.0;
	private bool textFileInFolder = false;
	private double applicationsLeft = 160.0;
	private double applicationsTop = 12.0;
	private double websitesLeft = 20.0;
	private double websitesTop = 200.0;
	private double photographyLeft = 20.0;
	private double photographyTop = 330.0;
	private double documentsLeft = 285.0;
	private double documentsTop = 12.0;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			objRef = DotNetObjectReference.Create(this);
			_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");
		}
		if (_jsModule != null && objRef != null)
		{
			await _jsModule.InvokeVoidAsync("registerFolderDrag", objRef);
			await _jsModule.InvokeVoidAsync("registerAppIconDrag", objRef);
			await _jsModule.InvokeVoidAsync("registerDesktopWindowDrag");
			await _jsModule.InvokeVoidAsync("registerLauncherIconDrag");
		}
		if (_focusNotepad)
		{
			_focusNotepad = false;
			try { await _notepadRef.FocusAsync(); } catch { }
		}
	}

	private async Task OpenNotepad()
	{
		notepadOpen = true;
		_focusNotepad = true;
		await BringWindowToFront("notepad-window");
	}

	private void CloseNotepad() => notepadOpen = false;

	private void CloseLauncher() => launcherOpen = false;

	private void CloseDocuments() => documentsOpen = false;

	private async Task OpenDocuments()
	{
		documentsOpen = true;
		await BringWindowToFront("documents-window");
	}

	private void OpenReadme() => readmeModalOpen = true;

	private void CloseReadme() => readmeModalOpen = false;

	private void OnReadmeKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter" || e.Key == " ")
		{
			OpenReadme();
		}
	}

	private async Task OpenLauncher()
	{
		launcherOpen = true;
		await BringWindowToFront("launcher-window");
	}

	private void ClosePhotography() => photographyOpen = false;

	private async Task OpenPhotography()
	{
		photographyOpen = true;
		await BringWindowToFront("photography-window");
	}

	private void CloseWebsites() => websitesOpen = false;

	private async Task OpenWebsites()
	{
		websitesOpen = true;
		await BringWindowToFront("websites-window");
	}

	private async Task BringWindowToFront(string windowId)
	{
		if (_jsModule != null)
		{
			await _jsModule.InvokeVoidAsync("bringToFront", windowId);
		}
	}

	[JSInvokable]
	public Task OnFolderMoved(double left, double top)
	{
		folderLeft = left;
		folderTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnFolderDeleted()
	{
		folderVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileMoved(double left, double top)
	{
		textFileLeft = left;
		textFileTop = top;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDeleted()
	{
		textFileVisible = false;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnTextFileDroppedInFolder()
	{
		textFileVisible = false;
		textFileInFolder = true;
		StateHasChanged();
		return Task.CompletedTask;
	}

	[JSInvokable]
	public Task OnAppIconMoved(string iconId, double left, double top)
	{
		switch (iconId)
		{
			case "desktop-icon-applications":
				applicationsLeft = left;
				applicationsTop = top;
				break;
			case "desktop-icon-websites":
				websitesLeft = left;
				websitesTop = top;
				break;
			case "desktop-icon-photography":
				photographyLeft = left;
				photographyTop = top;
				break;
			case "desktop-icon-documents":
				documentsLeft = left;
				documentsTop = top;
				break;
		}
		StateHasChanged();
		return Task.CompletedTask;
	}

	private void ReleaseFromFolder()
	{
		if (!textFileInFolder) return;
		textFileInFolder = false;
		textFileVisible = true;
		textFileLeft = folderLeft;
		textFileTop = folderTop + 85;
	}

	private void ResetAll()
	{
		if (folderVisible && (textFileVisible || textFileInFolder)) return;
		if (!folderVisible) { folderVisible = true; folderLeft = 60.0; folderTop = 12.0; }
		if (!textFileVisible && !textFileInFolder) { textFileVisible = true; textFileLeft = 60.0; textFileTop = 85.0; }
	}

	public async ValueTask DisposeAsync()
	{
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterFolderDrag"); } catch { }
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterAppIconDrag"); } catch { }
		try { if (_jsModule != null) await _jsModule.InvokeVoidAsync("unregisterDesktopWindowDrag"); } catch { }
		if (_jsModule != null) await _jsModule.DisposeAsync();
		objRef?.Dispose();
	}
}
