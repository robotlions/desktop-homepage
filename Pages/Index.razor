							<path d="M36 20 Q44 20 44 27 Q44 34 36 34" fill="none" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<ellipse cx="23" cy="18" rx="13" ry="2.5" fill="#4a2c1a" stroke="#000" stroke-width="1.5"/>
							<ellipse cx="23" cy="17" rx="11" ry="1.5" fill="#6b3e26" opacity="0.7"/>
						</svg>
					</span>
					<span class="launcher-label">Modern Coffee</span>
				</a>
				<a href="https://github.com/robotlions/in-key-mobile" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<circle cx="12" cy="34" r="7" fill="#1a1a1a" stroke="#000" stroke-width="2"/>
							<circle cx="12" cy="34" r="3" fill="#ffffff"/>
							<line x1="18" y1="34" x2="19" y2="10" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
							<line x1="19" y1="10" x2="19" y2="34" stroke="#000" stroke-width="2.5"/>
							<path d="M19 10 L20 11 Q20 16 19 16 Q19 11 18 10" fill="#000" stroke="#000" stroke-width="1"/>
							<path d="M19 16 L20 17 Q20 22 19 22 Q19 17 18 16" fill="#000" stroke="#000" stroke-width="1"/>
							<circle cx="30" cy="38" r="6" fill="#1a1a1a" stroke="#000" stroke-width="2"/>
							<circle cx="30" cy="38" r="2.5" fill="#ffffff"/>
							<line x1="35" y1="38" x2="36" y2="16" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
							<line x1="36" y1="16" x2="36" y2="38" stroke="#000" stroke-width="2.5"/>
							<path d="M36 16 L37 17 Q37 22 36 22 Q36 17 35 16" fill="#000" stroke="#000" stroke-width="1"/>
						</svg>
					</span>
					<span class="launcher-label">In Key</span>
				</a>
				<a href="https://github.com/robotlions/AtomicPress" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="18" y="3" width="12" height="6" rx="1.5" fill="#6b737f" stroke="#000" stroke-width="2"/>
							<path d="M16 9 L16 22 L32 22 L32 9 Z" fill="#c9ccd0" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<rect x="16" y="22" width="16" height="7" fill="#e4e8ef" stroke="#000" stroke-width="2"/>
							<path d="M14 29 L14 40 Q14 43 17 43 L31 43 Q34 43 34 40 L34 29 Z" fill="#9aa3ab" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<line x1="16" y1="33" x2="32" y2="33" stroke="#000" stroke-width="1.5"/>
							<line x1="16" y1="37" x2="32" y2="37" stroke="#000" stroke-width="1.5"/>
							<ellipse cx="24" cy="12" rx="5" ry="1.5" fill="#5a6168" opacity="0.7"/>
							<rect x="20" y="15" width="8" height="4" fill="#7a8088" stroke="#000" stroke-width="1.25"/>
						</svg>
					</span>
					<span class="launcher-label">AtomicPress</span>
				</a>
			</div>
		</div>

		<div id="notepad-window" class="notepad-window draggable-window @(notepadOpen ? string.Empty : "window-hidden")">
			<div id="notepad-titlebar" class="notepad-titlebar draggable-window-handle">
				<span>NOTEPAD</span>
				<button class="notepad-close" @onclick="CloseNotepad">✕</button>
			</div>
			<textarea @ref="_notepadRef" class="notepad-content" @bind="notepadContent" @bind:event="oninput"></textarea>
		</div>

		<div id="photography-window" class="photography-window draggable-window @(photographyOpen ? string.Empty : "window-hidden")">
			<div id="photography-titlebar" class="photography-titlebar draggable-window-handle">
				<span>PHOTOGRAPHY</span>
				<button class="photography-close" @onclick="ClosePhotography">✕</button>
			</div>
			<div class="photography-content">
				<a href="https://flickr.com/photos/183126740@N02/" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="4" y="6" width="34" height="6" rx="1.5" fill="#8a939c" stroke="#000" stroke-width="2"/>
							<path d="M10 12 L13 8 L29 8 L32 12 Z" fill="#a7b0b8" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<path d="M2 13 L40 13 L40 44 L2 44 Z" fill="#c9ccd0" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<path d="M0 10 L9 10 L12 14 L2 14 Z" fill="#9aa3ab" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<circle cx="21" cy="27" r="11" fill="#4a5a6c" stroke="#000" stroke-width="2"/>
							<circle cx="21" cy="27" r="7.5" fill="#2d4258" stroke="#000" stroke-width="2"/>
							<rect x="14" y="15" width="14" height="2" fill="#e8eaed" stroke="#000" stroke-width="1.25"/>
							<circle cx="35" cy="17" r="1.5" fill="#ff5d3b"/>
						</svg>
					</span>
					<span class="launcher-label">Photos</span>
				</a>
			</div>
		</div>

		<div id="websites-window" class="websites-window draggable-window @(websitesOpen ? string.Empty : "window-hidden")">
			<div id="websites-titlebar" class="websites-titlebar draggable-window-handle">
				<span>WORLD WIDE WEBSITES</span>
				<button class="websites-close" @onclick="CloseWebsites">✕</button>
			</div>
			<div class="launcher-content">
				<a href="https://dnd35.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<path d="M24 4 L42 14 L42 34 L24 44 L6 34 L6 14 Z" fill="#8b5e3c" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
							<path d="M24 4 L42 14 L24 24 L6 14 Z" fill="#a67048" stroke="#000" stroke-width="1.5" stroke-linejoin="round"/>
							<path d="M24 24 L42 14 L42 34 L24 44 Z" fill="#6b4528" stroke="#000" stroke-width="1.5" stroke-linejoin="round"/>
							<text x="24" y="29" text-anchor="middle" font-size="13" font-family="monospace" font-weight="bold" fill="#f5e6d3" stroke="#000" stroke-width="0.4">20</text>
						</svg>
					</span>
					<span class="launcher-label">D&D Characters</span>
				</a>
				<a href="https://scale-o-matic.robotlions.com" target="_blank" rel="noopener noreferrer" class="launcher-link">
					<span class="launcher-icon" aria-hidden="true">
						<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
							<rect x="4" y="8" width="40" height="24" rx="1.5" fill="#e8edf0" stroke="#000" stroke-width="2"/>
							<rect x="6" y="10" width="36" height="20" fill="#c9ccd0"/>
							<line x1="9" y1="10" x2="9" y2="30" stroke="#000" stroke-width="1.5"/>
							<line x1="9" y1="10" x2="9" y2="14" stroke="#000" stroke-width="3"/>
							<line x1="14" y1="10" x2="14" y2="30" stroke="#000" stroke-width="1"/>
							<line x1="14" y1="10" x2="14" y2="13" stroke="#000" stroke-width="2.5"/>
							<line x1="19" y1="10" x2="19" y2="30" stroke="#000" stroke-width="1.5"/>
							<line x1="19" y1="10" x2="19" y2="16" stroke="#000" stroke-width="3"/>
							<line x1="24" y1="10" x2="24" y2="30" stroke="#000" stroke-width="1"/>
							<line x1="24" y1="10" x2="24" y2="13" stroke="#000" stroke-width="2.5"/>
							<line x1="29" y1="10" x2="29" y2="30" stroke="#000" stroke-width="1.5"/>
							<line x1="29" y1="10" x2="29" y2="16" stroke="#000" stroke-width="3"/>
							<line x1="34" y1="10" x2="34" y2="30" stroke="#000" stroke-width="1"/>
							<line x1="34" y1="10" x2="34" y2="13" stroke="#000" stroke-width="2.5"/>
